<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#383838">

    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/repost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/pill"
            android:paddingHorizontal="9dp"
            android:paddingVertical="4dp"
            android:textColor="#fff"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/caption"
            style="@style/Shadow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="3"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/music"
            style="@style/Shadow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:drawableStart="@drawable/ic_music"
            android:drawablePadding="5dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="16dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="60dp">

            <View
                android:id="@+id/creator"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/avatar"
                android:contentDescription="View creator" />

            <TextView
                android:id="@+id/follow"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="bottom|center_horizontal"
                android:background="@drawable/follow"
                android:gravity="center"
                android:textSize="16sp" />
        </FrameLayout>

        <TextView android:id="@+id/like" style="@style/Rail" android:drawableTop="@drawable/ic_heart" />
        <TextView android:id="@+id/comments" style="@style/Rail" android:drawableTop="@drawable/ic_comment" />
        <TextView android:id="@+id/save" style="@style/Rail" android:drawableTop="@drawable/ic_bookmark" />

        <View
            android:id="@+id/disc"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/disc"
            android:contentDescription="Original sound" />
    </LinearLayout>
</FrameLayout>
